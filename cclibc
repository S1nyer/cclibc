USAGE = """\
cclibc — glibc 调试环境一键切换工具 (基于 glibc-all-in-one)

用法:
  cclibc switch <elf> <目标> [-n]     一键切换 libc 环境
        <目标> = libc 文件 (自动识别版本) | 版本号 (2.35 / 2.35-0ubuntu3.14) | 环境目录
        -n / --replace-needed          用 replace-needed 方式修改 (替代 rpath)
  cclibc restore <elf>                 从备份恢复原文件
  cclibc check <elf>                   查看 ELF 环境 / libc 版本信息
  cclibc list                          列出已下载的 libc 环境
  cclibc download <版本>               下载 libc 环境 (调用 glibc-aio)
  cclibc compile <源码.c> [版本] [-o out] [--arch amd64|i386]   针对旧 glibc 编译
  cclibc gdb <elf>                     打印该 ELF 的 gdb 调试命令
  cclibc debug <elf> [参数...]         用 pwndbg 启动调试 (自动绑定符号)
  cclibc run <elf> [参数...]           直接运行 (使用切换后的 libc)
  cclibc fix-dbg <版本>                补建调试符号 (build-id + 库目录绑定)

简写:  cclibc <elf>            == cclibc check <elf>
       cclibc <elf> <目标>     == cclibc switch <elf> <目标>

环境变量:
  CCLIBC_AIO   glibc-all-in-one 目录 (默认 ~/glibc-all-in-one)
  CCLIBC_LIBS  libs 目录 (默认 <AIO>/libs)
  CCLIBC_DEV   dev 包存放目录 (默认 ~/cclibc/dev)
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if argv[0] in ("-v", "--version"):
        print("cclibc v1.0")
        return 0

    cmd = argv[0]
    sub_cmds = {"switch", "restore", "list", "download",
                "gdb", "debug", "run", "check", "fix-dbg", "compile"}
    if cmd in sub_cmds:
        args = argv[1:]
    else:
        # 简写: cclibc <elf> [目标]
        if not os.path.exists(cmd):
            if "/" in cmd or cmd.startswith("."):
                err(f"文件不存在: {cmd}")
            else:
                err(f"未知命令: {cmd}")
                print(USAGE)
            return 1
        if len(argv) >= 2:
            return cmd_switch([cmd] + argv[1:])
        return cmd_check([cmd])

    try:
        if cmd == "switch":
            return cmd_switch(args)
        if cmd == "restore":
            return restore(args[0])
        if cmd == "list":
            return cmd_list(args)
        if cmd == "download":
            return cmd_download(args)
        if cmd == "gdb":
            return cmd_gdb(args)
        if cmd == "debug":
            return cmd_debug(args)
        if cmd == "run":
            return cmd_run(args)
        if cmd == "check":
            return cmd_check(args)
        if cmd == "fix-dbg":
            env = resolve_env(args[0])
            fix_dbg(env)
            created, total = bind_dbg(env)
            if total:
                if created:
                    ok(f"为 {env['id']} 绑定调试符号: 新建 {created} 个, 共 {total} 个库")
                else:
                    ok(f"{env['id']} 的调试符号绑定已就绪 ({total} 个库)")
            else:
                warn(f"{env['id']} 未找到可绑定的调试符号")
            return 0
        if cmd == "compile":
            return cmd_compile(args)
    except UserError as e:
        err(str(e))
        return 1
    except IndexError:
        err("缺少参数, 用法见: cclibc -h")
        return 1
    except FileNotFoundError as e:
        err(f"缺少外部命令: {e.filename} (请先安装依赖)")
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
