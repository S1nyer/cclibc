def cmd_switch(argv):
    elf = argv[0]
    if not os.path.isfile(elf):
        raise UserError(f"ELF 文件不存在: {elf}")
    arch = elf_arch(elf)
    if not arch:
        raise UserError(f"无法识别 {elf} 的架构 (ELF 文件?)")

    opts = {"replace_needed": False, "backup": True}
    targets = []
    for a in argv[1:]:
        if a in ("-n", "--replace-needed"):
            opts["replace_needed"] = True
        elif a == "--no-backup":
            opts["backup"] = False
        elif a.startswith("--arch="):
            arch = a.split("=", 1)[1]
        else:
            targets.append(a)

    if not targets:
        raise UserError("用法: cclibc switch <elf> <libc文件|版本号|环境目录> [-n]")

    info(f"ELF: {elf} ({arch})")
    env = resolve_env(targets[0], arch)
    patch_binary(elf, env, replace_needed=opts["replace_needed"],
                 backup=opts["backup"])
    return 0


